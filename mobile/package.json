{
  "name": "debt-destroyer-mobile",
  "version": "1.0.0",
  "description": "Debt Destroyer for iOS and Android. It uses the payoff engine in ../src/utils.",
  "main": "expo-router/entry",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web --port 8082",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start:e2e": "EXPO_PUBLIC_E2E=1 expo start",
    "ios:e2e": "EXPO_PUBLIC_E2E=1 expo run:ios",
    "android:e2e": "EXPO_PUBLIC_E2E=1 expo run:android",
    "e2e:ios": "scripts/e2e.sh ios",
    "e2e:android": "scripts/e2e.sh android",
    "e2e:both": "scripts/e2e.sh both",
    "e2e:web": "EXPO_PUBLIC_E2E=1 expo export --platform web --output-dir dist-e2e && node e2e-web/run.mjs dist-e2e"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "date-fns": "^3.6.0",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-haptics": "~58.0.8",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.0",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "nanoid": "^5.0.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "playwright": "1.56.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "yaml": "2.8.1"
  }
}
